+#include <qrt.h>
+/* QRT: a finger on the page - a tap is a click where it went down, a drag scrolls (as
+ * the shell's own browser and Kumo), so no text selection by dragging */
+static struct { int state, sx, sy, lx, ly; bool grab; } touch;   /* state: 0 none, 1 down, 2 scrolling */
+
 /* called back when click in browser window */
 static int
 fb_browser_window_click(fbtk_widget_t *widget, fbtk_callback_info *cbi)
 {
+	if (cbi->event->type == NSFB_EVENT_KEY_DOWN && cbi->event->value.keycode == NSFB_KEY_MOUSE_1) {
+		touch.state = 1;
+		touch.sx = touch.lx = cbi->x;
+		touch.sy = touch.ly = cbi->y;
+		touch.grab = fbtk_tgrab_pointer(widget);
+		return 1;
+	}
+	if (cbi->event->type == NSFB_EVENT_KEY_UP && cbi->event->value.keycode == NSFB_KEY_MOUSE_1 && touch.state) {
+		struct gui_window *tgw = cbi->context;
+		struct browser_widget_s *tbw = fbtk_get_userpw(widget);
+		int was = touch.state;
+		touch.state = 0;
+		if (touch.grab) {
+			fbtk_tgrab_pointer(widget);
+			touch.grab = false;
+		}
+		if (was == 1) {
+			int x0 = touch.sx + tbw->scrollx, y0 = touch.sy + tbw->scrolly;
+			browser_window_mouse_click(tgw->bw, BROWSER_MOUSE_PRESS_1, x0, y0);
+			browser_window_mouse_click(tgw->bw, BROWSER_MOUSE_CLICK_1, x0, y0);
+		}
+		return 1;
+	}
+
 	struct gui_window *gw = cbi->context;
 	struct browser_widget_s *bwidget = fbtk_get_userpw(widget);
 	browser_mouse_state mouse;
@@ -815,6 +844,22 @@ fb_browser_window_move(fbtk_widget_t *widget, fbtk_callback_info *cbi)
 	int x = cbi->x + bwidget->scrollx;
 	int y = cbi->y + bwidget->scrolly;
 
+	if (touch.state) {
+		int slop = fbtk_get_height(gw->toolbar) / 6;
+		if (touch.state == 1 && (abs(cbi->x - touch.sx) > slop || abs(cbi->y - touch.sy) > slop))
+			touch.state = 2;
+		if (touch.state == 2) {
+			int dx = touch.lx - cbi->x, dy = touch.ly - cbi->y;
+			if (dy != 0 && !browser_window_scroll_at_point(gw->bw, x, y, 0, dy))
+				widget_scroll_y(gw, dy, false);
+			if (dx != 0 && !browser_window_scroll_at_point(gw->bw, x, y, dx, 0))
+				widget_scroll_x(gw, dx, false);
+		}
+		touch.lx = cbi->x;
+		touch.ly = cbi->y;
+		return 1;
+	}
+
