# QRT (ports/netsurf.sh): the framebuffer front-end on QRT's libnsfb surface
override NETSURF_FB_FRONTEND := qrt
override NETSURF_USE_DUKTAPE := YES
override NETSURF_USE_WEBP := NO
override NETSURF_USE_VIDEO := NO
override NETSURF_USE_HARU_PDF := NO
override NETSURF_USE_ROSPRITE := NO
override NETSURF_USE_RSVG := NO
override NETSURF_USE_NSSVG := YES
override NETSURF_USE_NSPSL := YES
override NETSURF_USE_OPENSSL := YES
override NETSURF_USE_UTF8PROC := YES
override NETSURF_FB_FONTLIB := freetype
override NETSURF_FB_FONTPATH := /share/fonts
override NETSURF_FB_FONT_SANS_SERIF := DejaVuSans.ttf
override NETSURF_FB_FONT_SANS_SERIF_BOLD := DejaVuSans-Bold.ttf
override NETSURF_FB_FONT_SANS_SERIF_ITALIC := LiberationSans-Italic.ttf
override NETSURF_FB_FONT_SANS_SERIF_ITALIC_BOLD := LiberationSans-BoldItalic.ttf
override NETSURF_FB_FONT_SERIF := LiberationSerif-Regular.ttf
override NETSURF_FB_FONT_SERIF_BOLD := LiberationSerif-Bold.ttf
override NETSURF_FB_FONT_MONOSPACE := DejaVuSansMono.ttf
override NETSURF_FB_FONT_MONOSPACE_BOLD := DejaVuSansMono-Bold.ttf
override NETSURF_FB_FONT_CURSIVE := LiberationSerif-Italic.ttf
override NETSURF_FB_FONT_FANTASY := DejaVuSans-Bold.ttf
override NETSURF_FRAMEBUFFER_RESOURCES := /share/netsurf
override NETSURF_FB_RESPATH := /share/netsurf
