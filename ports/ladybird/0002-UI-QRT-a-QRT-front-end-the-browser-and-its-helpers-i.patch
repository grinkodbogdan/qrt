diff --git a/UI/QRT/CMakeLists.txt b/UI/QRT/CMakeLists.txt
new file mode 100644
index 00000000..d548c354
--- /dev/null
+++ b/UI/QRT/CMakeLists.txt
@@ -0,0 +1,30 @@
+# The QRT front-end (github.com/grinkodbogdan/qrt): one static executable that is both the
+# browser and, started as "ladybird <Helper>", each of its helper processes.
+add_executable(ladybird main.cpp Application.cpp SandboxQRT.cpp)
+
+set(qrt_helpers Compositor ImageDecoder MediaServer RequestServer WebContent WebWorker)
+if (ENABLE_CRANELIFT_JIT)
+    list(APPEND qrt_helpers WasmCompiler)
+    target_compile_definitions(ladybird PRIVATE QRT_HAVE_WASM_COMPILER)
+endif()
+foreach (helper IN LISTS qrt_helpers)
+    set(main "${LADYBIRD_SOURCE_DIR}/Services/${helper}/main.cpp")
+    target_sources(ladybird PRIVATE "${main}")
+    set_source_files_properties("${main}" PROPERTIES COMPILE_DEFINITIONS "ladybird_main=qrt_${helper}_main")
+endforeach()
+# sandboxes: QRT has no seccomp or landlock
+target_sources(ladybird PRIVATE
+    ${LADYBIRD_SOURCE_DIR}/Services/RendererSandboxUnimplemented.cpp
+    ${LADYBIRD_SOURCE_DIR}/Services/Compositor/SandboxUnimplemented.cpp
+    ${LADYBIRD_SOURCE_DIR}/Services/ImageDecoder/SandboxUnimplemented.cpp
+    ${LADYBIRD_SOURCE_DIR}/Services/MediaServer/SandboxUnimplemented.cpp
+    ${LADYBIRD_SOURCE_DIR}/Services/RequestServer/SandboxUnimplemented.cpp
+)
+if (ENABLE_CRANELIFT_JIT)
+    target_sources(ladybird PRIVATE ${LADYBIRD_SOURCE_DIR}/Services/WasmCompiler/SandboxUnimplemented.cpp)
+    target_link_libraries(ladybird PRIVATE wasmcompilerservice)
+endif()
+target_link_libraries(ladybird PRIVATE compositorservice imagedecoderservice mediaserverservice requestserverservice
+    webcontentservice webworkerservice LibSandbox LibThreading LibMedia LibURL LibWeb LibJS LibGC LibUnicode)
+target_include_directories(ladybird PRIVATE ${LADYBIRD_SOURCE_DIR}/Services ${CMAKE_BINARY_DIR}/Services ${CMAKE_BINARY_DIR})
+create_ladybird_bundle(ladybird)
