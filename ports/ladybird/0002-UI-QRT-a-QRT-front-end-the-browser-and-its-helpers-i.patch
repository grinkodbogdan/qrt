--- /dev/null
+++ b/UI/QRT/main.cpp
@@ -0,0 +1,54 @@
+/*
+ * Copyright (c) 2026, the QRT developers.
+ *
+ * SPDX-License-Identifier: BSD-2-Clause
+ */
+
+// One program, several processes: on QRT, Ladybird's helper processes are this same
+// executable started as "ladybird <Helper> args..." (see launch_server_process), so the
+// libraries they share (LibWeb, LibJS, ICU's data...) are on the disk once.
+
+#include <AK/StringView.h>
+#include <LibMain/Main.h>
+#include <LibWebView/Application.h>
+#include <UI/QRT/Application.h>
+
+#define QRT_HELPERS(X) \
+    X(Compositor)      \
+    X(ImageDecoder)    \
+    X(MediaServer)     \
+    X(RequestServer)   \
+    X(WebContent)      \
+    X(WebWorker)       \
+    QRT_WASM_HELPER(X)
+
+#ifdef QRT_HAVE_WASM_COMPILER
+#    define QRT_WASM_HELPER(X) X(WasmCompiler)
+#else
+#    define QRT_WASM_HELPER(X)
+#endif
+
+#define DECLARE_HELPER(name) ErrorOr<int> qrt_##name##_main(Main::Arguments);
+QRT_HELPERS(DECLARE_HELPER)
+
+ErrorOr<int> ladybird_main(Main::Arguments arguments)
+{
+    if (arguments.argc > 1) {
+        auto helper = arguments.strings[1];
+        Main::Arguments shifted { arguments.argc - 1, arguments.argv + 1, arguments.strings.slice(1) };
+#define RUN_HELPER(name)        \
+    if (helper == #name##sv)    \
+        return qrt_##name##_main(shifted);
+        QRT_HELPERS(RUN_HELPER)
+    }
+
+    AK::set_rich_debug_enabled(true);
+    auto app = TRY(Ladybird::Application::create(arguments));
+    if (app->should_exit_after_profile_coordination())
+        return 0;
+    if (!Ladybird::Application::browser_options().headless_mode.has_value()) {
+        warnln("ladybird: the QRT window is not there yet; use --headless=screenshot|text|layout-tree");
+        return 1;
+    }
+    return app->execute();
+}
