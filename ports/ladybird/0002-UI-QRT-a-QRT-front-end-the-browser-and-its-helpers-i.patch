+#pragma once
+
+#include <LibWebView/Application.h>
+
+namespace Ladybird {
+
+// The QRT front-end: Ladybird as a native program on QRT (github.com/grinkodbogdan/qrt).
+// For now it runs headless (--headless=screenshot|text|layout-tree); its window in the QRT
+// shell comes next.
