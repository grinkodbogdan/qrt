+/*
+ * Copyright (c) 2026, the QRT developers.
+ *
+ * SPDX-License-Identifier: BSD-2-Clause
+ */
+
+#pragma once
+
+#include <AK/ByteString.h>
+#include <AK/OwnPtr.h>
+#include <LibCore/Forward.h>
+#include <LibURL/URL.h>
+#include <LibWebView/HeadlessWebView.h>
+
+extern "C" {
+#include <qrt.h>
+}
+
+namespace Ladybird {
+
+// The page: a web view whose frames are copied into the QRT window under the toolbar.
+class PageView final : public ::WebView::HeadlessWebView {
+public:
+    AK_ALLOC_WITH_KMALLOC;
+
+    static NonnullOwnPtr<PageView> create(Core::AnonymousBuffer theme, Web::DevicePixelSize);
+
+    // the last frame WebContent painted, and its size
+    RefPtr<Gfx::Bitmap> frame(Gfx::IntSize& size) const;
+
+private:
+    PageView(Core::AnonymousBuffer theme, Web::DevicePixelSize size)
+        : HeadlessWebView(move(theme), size)
+    {
+    }
+};
+
+// Ladybird's window in the QRT shell: a toolbar (back, forward, reload, the address,
+// the on-screen keyboard) and the page.  Touch drags scroll, taps click; the mouse
+// and the keyboard go to the page, or to the address while it is being edited.
+class BrowserWindow {
+public:
+    AK_ALLOC_WITH_KMALLOC;
+
+    static ErrorOr<NonnullOwnPtr<BrowserWindow>> create(Vector<URL::URL> const& urls);
+    ~BrowserWindow();
+
+private:
+    BrowserWindow() = default;
+    ErrorOr<void> initialize(Vector<URL::URL> const& urls);
+
+    void handle_events();
+    void handle(qrt_event const&);
+    void map_buffer();
+    void layout_changed();
+
+    void draw_toolbar();
+    void draw_page();
+    void present_all();
+
+    void tap_toolbar(int x);
+    void address_key(u32 ch, u32 scan);
+    void page_key(u32 ch, u32 scan);
+    void send_mouse(Web::MouseEvent::Type, int x, int y, Web::UIEvents::MouseButton button, Web::UIEvents::MouseButton buttons, double wheel_y = 0);
+
+    int content_top() const { return m_toolbar_height; }
+    Web::DevicePixelSize viewport() const;
+
+    int m_window { -1 };
+    int m_event_fd { -1 };
+    qrt_buffer m_buffer {};
+    int m_toolbar_height { 52 };
+    RefPtr<Core::Notifier> m_notifier;
+    OwnPtr<PageView> m_view;
+
+    ByteString m_title { "Ladybird" };
+    ByteString m_address;
+    bool m_editing_address { false };
+    bool m_replace_address { false };
+    bool m_loading { false };
+    bool m_keyboard { false };
+
+    // a finger on the page: a tap clicks, a drag scrolls
+    bool m_finger_down { false };
+    bool m_dragging { false };
+    bool m_mouse { false };
+    int m_down_x { 0 }, m_down_y { 0 }, m_last_y { 0 }, m_last_x { 0 };
+};
+
+}
