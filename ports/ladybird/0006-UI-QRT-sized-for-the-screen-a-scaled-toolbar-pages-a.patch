+u64 BrowserWindow::now_ms()
+{
+    return static_cast<u64>(MonotonicTime::now().milliseconds());
+}
+
+// the page moves by dy device pixels; its scroll offsets are CSS pixels
+void BrowserWindow::scroll_page(double dy)
+{
+    using Type = Web::MouseEvent::Type;
+    auto const none = Web::UIEvents::MouseButton::None;
+    send_mouse(Type::MouseWheel, m_down_x, max(m_down_y, content_top()), none, none, dy / m_page_ratio);
+}
+
+void BrowserWindow::fling_step()
+{
+    m_velocity *= 0.95;
+    if (fabs(m_velocity) < 0.05 || m_finger_down) {
+        m_fling->stop();
+        return;
+    }
+    // whole pixels only, the rest carries over to the next frame
+    m_fling_carry += m_velocity * 16;
+    double step = trunc(m_fling_carry);
+    m_fling_carry -= step;
+    if (step != 0)
+        scroll_page(step);
+}
+
 void BrowserWindow::tap_toolbar(int x)
 {
     switch (toolbar_item_at(x)) {
