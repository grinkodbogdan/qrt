@@ -0,0 +1,144 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * QRT: Linux's SoC drivers run inside QRT's kernel (Tessera) on ARM phones.
+ * The host sets these before lkl_start_kernel():
+ *   lkl_qrt_fdt         the boot loader's flattened device tree
+ *   lkl_qrt_dma_base    a physically contiguous region the host maps uncached,
+ *   lkl_qrt_dma_size    for dma_alloc_coherent() (the SoC's DMA does not snoop)
+ * Physical == virtual on the host, so DMA addresses need no translation.
+ */
+#include <linux/init.h>
+#include <linux/of.h>
+#include <linux/of_fdt.h>
+#include <linux/dma-map-ops.h>
+#include <linux/arm-smccc.h>
+
+void *lkl_qrt_fdt;
+unsigned long lkl_qrt_dma_base, lkl_qrt_dma_size;
+
+#ifdef CONFIG_MMU
+/*
+ * Argon: Linux's "physical" addresses are its addresses in the host's window
+ * (memory_start..memory_end); the host keeps that RAM in one block at
+ * lkl_qrt_ram_phys (set in its shmem_init).  Devices get real addresses;
+ * anything outside Linux's RAM (the coherent pool, MMIO) is already real.
+ */
+#include <linux/dma-direct.h>
+unsigned long lkl_qrt_ram_phys;
+extern unsigned long memory_start, memory_end;
+
+dma_addr_t phys_to_dma(struct device *dev, phys_addr_t paddr)
+{
+	if (paddr >= memory_start && paddr < memory_end)
+		return paddr - memory_start + lkl_qrt_ram_phys;
+	return paddr;
+}
+
+phys_addr_t dma_to_phys(struct device *dev, dma_addr_t daddr)
+{
+	if (daddr >= lkl_qrt_ram_phys &&
+	    daddr < lkl_qrt_ram_phys + (memory_end - memory_start))
+		return daddr - lkl_qrt_ram_phys + memory_start;
+	return daddr;
+}
+#endif
+
+void __init lkl_qrt_soc_setup(void)
+{
+	if (!lkl_qrt_fdt)
+		return;
+	if (!early_init_dt_verify(lkl_qrt_fdt)) {
+		pr_err("qrt: the device tree is not valid\n");
+		return;
+	}
+	unflatten_device_tree();
+	pr_info("qrt: device tree: %s\n", of_flat_dt_get_machine_name());
+}
+
+static int __init lkl_qrt_dma_pool(void)
+{
+	if (lkl_qrt_dma_size)
+		return dma_init_global_coherent(lkl_qrt_dma_base, lkl_qrt_dma_size);
+	return 0;
+}
+core_initcall(lkl_qrt_dma_pool);
+
+#if defined(__aarch64__)
+static inline void qrt_dcache(unsigned long a, unsigned long e, int op)
+{
+	for (a &= ~63UL; a < e; a += 64) {
+		if (op == 0)
+			asm volatile("dc cvac, %0" : : "r"(a) : "memory");
+		else
+			asm volatile("dc civac, %0" : : "r"(a) : "memory");
+	}
+	asm volatile("dsb sy" : : : "memory");
+}
+#else
+static inline void qrt_dcache(unsigned long a, unsigned long e, int op) { }
+#endif
+
+/* to the device: write back what the CPU wrote; from it: drop what we cached */
+void arch_sync_dma_for_device(phys_addr_t paddr, size_t size,
+			      enum dma_data_direction dir)
+{
+	qrt_dcache(paddr, paddr + size, dir == DMA_TO_DEVICE ? 0 : 1);
+}
+
+void arch_sync_dma_for_cpu(phys_addr_t paddr, size_t size,
+			   enum dma_data_direction dir)
+{
+	if (dir != DMA_TO_DEVICE)
+		qrt_dcache(paddr, paddr + size, 1);
+}
+
+#if defined(__aarch64__)
+/* SMC calls (secure monitor: SCM, PSCI): Linux runs at EL1 inside the host */
+void __arm_smccc_smc(unsigned long a0, unsigned long a1, unsigned long a2,
+		     unsigned long a3, unsigned long a4, unsigned long a5,
+		     unsigned long a6, unsigned long a7,
+		     struct arm_smccc_res *res, struct arm_smccc_quirk *quirk)
+{
+	register unsigned long x0 asm("x0") = a0, x1 asm("x1") = a1,
+		x2 asm("x2") = a2, x3 asm("x3") = a3, x4 asm("x4") = a4,
+		x5 asm("x5") = a5, x6 asm("x6") = a6, x7 asm("x7") = a7;
+
+	asm volatile("smc #0"
+		     : "+r"(x0), "+r"(x1), "+r"(x2), "+r"(x3), "+r"(x4),
+		       "+r"(x5), "+r"(x6), "+r"(x7)
+		     : : "x8", "x9", "x10", "x11", "x12", "x13", "x14", "x15",
+		       "x16", "x17", "memory");
+	if (res) {
+		res->a0 = x0;
+		res->a1 = x1;
+		res->a2 = x2;
+		res->a3 = x3;
+	}
+	if (quirk && quirk->id == ARM_SMCCC_QUIRK_QCOM_A6)
+		quirk->state.a6 = x6;
+}
+EXPORT_SYMBOL(__arm_smccc_smc);
+
+void __arm_smccc_hvc(unsigned long a0, unsigned long a1, unsigned long a2,
+		     unsigned long a3, unsigned long a4, unsigned long a5,
+		     unsigned long a6, unsigned long a7,
+		     struct arm_smccc_res *res, struct arm_smccc_quirk *quirk)
+{
+	register unsigned long x0 asm("x0") = a0, x1 asm("x1") = a1,
+		x2 asm("x2") = a2, x3 asm("x3") = a3, x4 asm("x4") = a4,
+		x5 asm("x5") = a5, x6 asm("x6") = a6, x7 asm("x7") = a7;
+
+	asm volatile("hvc #0"
+		     : "+r"(x0), "+r"(x1), "+r"(x2), "+r"(x3), "+r"(x4),
+		       "+r"(x5), "+r"(x6), "+r"(x7)
+		     : : "x8", "x9", "x10", "x11", "x12", "x13", "x14", "x15",
+		       "x16", "x17", "memory");
+	if (res) {
+		res->a0 = x0;
+		res->a1 = x1;
+		res->a2 = x2;
+		res->a3 = x3;
+	}
+}
+EXPORT_SYMBOL(__arm_smccc_hvc);
+#endif
