diff --git a/arch/lkl/drivers/qrt-gic.c b/arch/lkl/drivers/qrt-gic.c
new file mode 100644
index 000000000..a84735768
--- /dev/null
+++ b/arch/lkl/drivers/qrt-gic.c
@@ -0,0 +1,122 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * QRT: the ARM GICv2 distributor as Linux's interrupt controller inside QRT's
+ * kernel.  Linux masks, unmasks and configures its shared interrupts (SPIs)
+ * here; they sit below the CPU interface's priority mask, so they never
+ * interrupt the CPU: the host finds them pending and enabled in the
+ * distributor and runs lkl_trigger_irq(QRT_GIC_VIRQ_BASE + id).  The CPU
+ * interface, SGIs and PPIs are the host's (its scheduler's timer).
+ * hwirq n is Linux irq QRT_GIC_VIRQ_BASE + n (a legacy domain).
+ */
+#include <linux/init.h>
+#include <linux/io.h>
+#include <linux/irq.h>
+#include <linux/irqchip.h>
+#include <linux/irqdomain.h>
+#include <linux/of.h>
+#include <linux/of_address.h>
+
+#define QRT_GIC_VIRQ_BASE 1024
+#define QRT_GIC_NR 1020
+
+static void __iomem *dist;
+unsigned long qrt_gic_cpu_base;		/* the distributor, for the host's poller */
+EXPORT_SYMBOL(qrt_gic_cpu_base);
+unsigned long qrt_gic_lines;
+EXPORT_SYMBOL(qrt_gic_lines);
+
+static void qrt_gic_mask(struct irq_data *d)
+{
+	unsigned long hw = irqd_to_hwirq(d);
+
+	writel_relaxed(BIT(hw % 32), dist + 0x180 + 4 * (hw / 32));
+}
+
+static void qrt_gic_unmask(struct irq_data *d)
+{
+	unsigned long hw = irqd_to_hwirq(d);
+
+	writel_relaxed(BIT(hw % 32), dist + 0x100 + 4 * (hw / 32));
+}
+
+/* acknowledged (IAR) and ended (EOIR) by the host's poller */
+static void qrt_gic_ack(struct irq_data *d)
+{
+}
+
+static int qrt_gic_set_type(struct irq_data *d, unsigned int type)
+{
+	unsigned long hw = irqd_to_hwirq(d);
+	u32 off = 0xc00 + 4 * (hw / 16), bit = BIT((hw % 16) * 2 + 1), v;
+	bool edge = type & IRQ_TYPE_EDGE_BOTH;
+
+	if (hw >= 32) {
+		v = readl_relaxed(dist + off);
+		writel_relaxed(edge ? v | bit : v & ~bit, dist + off);
+	}
+	irq_set_handler_locked(d, edge ? handle_edge_irq : handle_level_irq);
+	return 0;
+}
+
+static struct irq_chip qrt_gic_chip = {
+	.name = "qrt-gic",
+	.irq_mask = qrt_gic_mask,
+	.irq_unmask = qrt_gic_unmask,
+	.irq_ack = qrt_gic_ack,
+	.irq_set_type = qrt_gic_set_type,
+	.flags = IRQCHIP_SKIP_SET_WAKE,
+};
+
+static int qrt_gic_map(struct irq_domain *d, unsigned int virq,
+		       irq_hw_number_t hw)
+{
+	irq_set_chip_and_handler(virq, &qrt_gic_chip, handle_level_irq);
+	irq_set_probe(virq);
+	return 0;
+}
+
+static int qrt_gic_xlate(struct irq_domain *d, struct device_node *ctrlr,
+			 const u32 *spec, unsigned int size,
+			 irq_hw_number_t *hw, unsigned int *type)
+{
+	if (size < 3)
+		return -EINVAL;
+	*hw = spec[1] + (spec[0] == 0 ? 32 : 16);	/* SPI or PPI */
+	*type = spec[2] & IRQ_TYPE_SENSE_MASK;
+	return 0;
+}
+
+static const struct irq_domain_ops qrt_gic_ops = {
+	.map = qrt_gic_map,
+	.xlate = qrt_gic_xlate,
+};
+
+static int __init qrt_gic_init(struct device_node *node,
+			       struct device_node *parent)
+{
+	u32 lines, i;
+
+	dist = of_iomap(node, 0);
+	if (!dist)
+		return -ENOMEM;
+	lines = min_t(u32, 32 * ((readl_relaxed(dist + 0x004) & 0x1f) + 1), QRT_GIC_NR);
+	for (i = 32; i < lines; i += 32)
+		writel_relaxed(~0u, dist + 0x180 + i / 8);	/* SPIs masked */
+	for (i = 32; i < lines; i += 4)
+		writel_relaxed(0x01010101, dist + 0x800 + i);	/* to CPU 0 */
+	for (i = 32; i < lines; i += 4)
+		writel_relaxed(0xa0a0a0a0, dist + 0x400 + i);	/* under the host's mask */
+	writel_relaxed(1, dist);
+	qrt_gic_lines = lines;
+	qrt_gic_cpu_base = (unsigned long)dist;
+	if (!irq_domain_add_legacy(node, lines, QRT_GIC_VIRQ_BASE, 0,
+				   &qrt_gic_ops, NULL))
+		return -ENOMEM;
+	pr_info("qrt-gic: %u interrupt lines, Linux irqs %d..\n", lines,
+		QRT_GIC_VIRQ_BASE);
+	return 0;
+}
+IRQCHIP_DECLARE(qrt_gic400, "arm,gic-400", qrt_gic_init);
+IRQCHIP_DECLARE(qrt_a15, "arm,cortex-a15-gic", qrt_gic_init);
+IRQCHIP_DECLARE(qrt_a7, "arm,cortex-a7-gic", qrt_gic_init);
+IRQCHIP_DECLARE(qrt_qgic2, "qcom,msm-qgic2", qrt_gic_init);
diff --git a/arch/lkl/include/asm/barrier.h b/arch/lkl/include/asm/barrier.h
new file mode 100644
index 000000000..c25ddb2a8
--- /dev/null
+++ b/arch/lkl/include/asm/barrier.h
@@ -0,0 +1,22 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+#ifndef _ASM_LKL_BARRIER_H
+#define _ASM_LKL_BARRIER_H
+
+/*
+ * QRT: Linux runs on one LKL CPU, but drivers order their memory accesses against
+ * devices (DMA, shadow doorbells) with mb()/rmb()/wmb(); on an x86-64 host those need
+ * the real fences, not just a compiler barrier.
+ */
+#if defined(__x86_64__)
+#define mb()	asm volatile("mfence" ::: "memory")
+#define rmb()	asm volatile("lfence" ::: "memory")
+#define wmb()	asm volatile("sfence" ::: "memory")
+#elif defined(__aarch64__)
+#define mb()	asm volatile("dmb sy" ::: "memory")
+#define rmb()	asm volatile("dmb ld" ::: "memory")
+#define wmb()	asm volatile("dmb st" ::: "memory")
+#endif
+
+#include <asm-generic/barrier.h>
+
+#endif
