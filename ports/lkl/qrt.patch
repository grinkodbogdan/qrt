 }
 
+#ifdef CONFIG_LKL_QRT_SOC
+/* QRT: this thread holds the LKL CPU (irq.c: lkl_qrt_irq_tail) */
+int lkl_cpu_mine(void)
+{
+	lkl_thread_t o = READ_ONCE(cpu.owner);
+
+	return o && cpu.count && lkl_ops->thread_equal(o, lkl_ops->thread_self());
