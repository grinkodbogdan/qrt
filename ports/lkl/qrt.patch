+		       "+r"(x5), "+r"(x6), "+r"(x7)
+		     : : "x8", "x9", "x10", "x11", "x12", "x13", "x14", "x15",
+		       "x16", "x17", "memory");
+	if (res) {
+		res->a0 = x0;
+		res->a1 = x1;
+		res->a2 = x2;
+		res->a3 = x3;
+	}
+}
+EXPORT_SYMBOL(__arm_smccc_hvc);
+#endif
