+static void qcom_fg_remove(struct platform_device *pdev)
+{
+	struct qcom_fg_chip *chip = platform_get_drvdata(pdev);
+
+	if(chip->sram_wq)
+		destroy_workqueue(chip->sram_wq);
+}
