--- a/arch/lkl/kernel/irq.c
+++ b/arch/lkl/kernel/irq.c
@@ -11,6 +11,7 @@
 #include <asm/host_ops.h>
 #include <asm/cpu.h>
 #include <linux/cpu.h>
+#include <linux/irqchip.h>
 
 /*
  * To avoid much overhead we use an indirect approach: the irqs are marked using
@@ -143,6 +144,10 @@ int lkl_get_free_irq(const char *user)
 
 	/* 0 is not a valid IRQ */
 	for (i = 1; i < NR_IRQS; i++) {
+#ifdef CONFIG_LKL_QRT_SOC
+		if (i >= 64)		/* the rest belong to irq domains */
+			break;
+#endif
 		if (!irqs[i].user) {
 			irqs[i].user = user;
 			if (lkl_is_running())
@@ -214,12 +219,50 @@ void arch_local_irq_restore(unsigned long flags)
 	irqs_enabled = flags;
 }
 
+#ifdef CONFIG_LKL_QRT_SOC
+int lkl_cpu_mine(void);
+/*
+ * QRT: the host's own timer interrupt found this thread running Linux code.  With
+ * Linux's interrupts on, run what is pending now, as a real CPU would - a driver
+ * that spins on jiffies (or on a flag an interrupt sets) without cpu_relax() would
+ * otherwise wait for an interrupt that cannot arrive while it holds the CPU.
+ */
+int lkl_qrt_irq_tail(void)
+{
+	if (irqs_enabled != ARCH_IRQ_ENABLED)
+		return -1;
+	if (in_interrupt())
+		return -2;
+	if (!READ_ONCE(irq_index_status))
+		return -3;
+	if (!lkl_cpu_mine())
+		return -4;
+	irqs_enabled = ARCH_IRQ_DISABLED;
+	run_irqs();
+	irqs_enabled = ARCH_IRQ_ENABLED;
+	return 1;
+}
+#endif
+
 void init_IRQ(void)
 {
 	int i;
 
+#ifdef CONFIG_LKL_QRT_SOC
+	/*
+	 * Setting a chip marks the irq allocated: only LKL's own few are
+	 * claimed here, so irq domains (the GPIO controllers') can allocate
+	 * the rest; the GIC's legacy domain claims its own at 1024..
+	 */
+	for (i = 0; i < 64; i++)
+		irq_set_chip_and_handler(i, &dummy_irq_chip, handle_simple_irq);
+#else
 	for (i = 0; i < NR_IRQS; i++)
 		irq_set_chip_and_handler(i, &dummy_irq_chip, handle_simple_irq);
+#endif
+#ifdef CONFIG_LKL_QRT_SOC
+	irqchip_init();			/* the device tree's interrupt controllers */
+#endif
 
 	pr_info("lkl: irqs initialized\n");
 }
