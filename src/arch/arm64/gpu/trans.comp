#version 450
// The shell's transitions (shell.c trans_rows), on the GPU: the old picture (a) and the
// new one (b) blended straight into the screen (o).  One invocation does four pixels
// side by side, read and written 16 bytes at a time (0.28.5: one pixel a time took
// ~0.2 s a frame); rows and widths are multiples of 4 pixels.  The grid is (W / 256, H).
// Kinds: 1 rise, 2 sink, 3 fade, 4 unlock.
layout(local_size_x = 64) in;
layout(std430, set = 0, binding = 0) readonly buffer A { uvec4 a[]; };
layout(std430, set = 0, binding = 1) readonly buffer B { uvec4 b[]; };
layout(std430, set = 0, binding = 2) writeonly buffer O { uvec4 o[]; };
layout(push_constant) uniform P {
    uint w, h, stride, ostride;        // pixels; source and screen rows in pixels
    uint kind, t, shift, pad;          // t 0..256 (a -> b); shift: the rows moved
    int cax, cay, caw, cah;            // the content area (x and width: multiples of 4)
} p;

uvec4 lerp4(uvec4 x, uvec4 y, uint t) {
    uvec4 rb = (((x & 0xff00ffu) * (256u - t) + (y & 0xff00ffu) * t) >> 8) & 0xff00ffu;
    uvec4 g = (((x & 0x00ff00u) * (256u - t) + (y & 0x00ff00u) * t) >> 8) & 0x00ff00u;
    return 0xff000000u | rb | g;
}

void main() {
    int q = int(gl_GlobalInvocationID.x), y = int(gl_GlobalInvocationID.y);
    int x = q * 4;
    if (x >= int(p.w) || y >= int(p.h)) return;
    uint s4 = p.stride / 4u, k = p.kind;
    uint oi = uint(y) * (p.ostride / 4u) + uint(q);
    bool rows = y >= p.cay && y < p.cay + p.cah;
    if (k != 3u && k != 4u && !rows) { o[oi] = b[uint(y) * s4 + uint(q)]; return; }
    if ((k == 1u || k == 2u) && (x < p.cax || x >= p.cax + p.caw)) { o[oi] = b[uint(y) * s4 + uint(q)]; return; }
    uvec4 pa, pb;
    if (k == 1u) {                                        // the new view rises in
        int sy = min(y + int(p.shift), p.cay + p.cah - 1);
        pa = a[uint(y) * s4 + uint(q)]; pb = b[uint(sy) * s4 + uint(q)];
    } else if (k == 2u) {                                 // the old view sinks
        int sy = max(y - int(p.shift), p.cay);
        pb = b[uint(y) * s4 + uint(q)]; pa = a[uint(sy) * s4 + uint(q)];
    } else if (k == 4u) {                                 // the lock screen slides up
        int sy = y + int(p.shift);
        pb = b[uint(y) * s4 + uint(q)];
        pa = sy < int(p.h) ? a[uint(sy) * s4 + uint(q)] : pb;
    } else {
        pa = a[uint(y) * s4 + uint(q)]; pb = b[uint(y) * s4 + uint(q)];
    }
    o[oi] = p.t >= 256u ? pb : p.t == 0u ? pa : lerp4(pa, pb, p.t);
}
